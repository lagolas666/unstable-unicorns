// Хвосты победы: winnerId — защёлка, а не «последний, кто успел».
// Три точки записи в gameService.ts писали победителя безусловно:
//   L432 (performPlayNow), L640 (конец playCard), L671 (endTurn).
// Образец правильного вида уже есть: L748 и engine/leader.ts L65.
//
// Фикстура: winnerId выставлен заранее за p1, у p2 ровно порог единорогов.
// Тогда checkWin(state) возвращает 'p2' (он и в самом деле догнал порог),
// и незащищённая запись затирает уже объявленного победителя p1.
// Позитивные кейсы держат обратное: если winnerId пуст — победа обязана записаться,
// иначе guard превратится в «никогда не выигрывать».

import { games } from '../src/gameStore';
import { playCard, endTurn, performPlayNow, checkWin } from '../src/gameService';
import { EventBus } from '../src/engine/events';

const THRESHOLD = 7; // 2 игрока → WIN_UNICORNS_BASE

function mkPlayer(id: string, extra: any = {}) {
  return {
    id,
    deck: [],
    hand: [],
    discard: [],
    stable: [],
    nursery: [],
    field: [],
    action_points: 1,
    ...extra,
  };
}

/** Состояние на двух игроков: p1 — ходящий, p2 — соперник. */
function mkState(over: any = {}) {
  return {
    players: [mkPlayer('p1'), mkPlayer('p2')],
    cards: {} as Record<string, any>,
    deck: ['z1', 'z2'], // непустая колода: отсекаем фоллбек-тайбрейк, проверяем именно порог
    discard: [] as string[],
    turn: { currentPlayerId: 'p1', phase: 'action', has_drawn: false },
    ...over,
  } as any;
}

function uni(id: string, extra: any = {}) {
  return { id, name: id.toUpperCase(), type: 'basic_unicorn', effects: [], ...extra };
}

/** Кладёт n единорогов в стойло игрока, заводя их в state.cards. */
function giveUnicorns(state: any, playerId: string, n: number, prefix: string) {
  const player = state.players.find((p: any) => p.id === playerId);
  for (let i = 1; i <= n; i++) {
    const id = `${prefix}${i}`;
    state.cards[id] = uni(id);
    player.stable.push(id);
  }
}

/** Регистрирует состояние в общем сторе; возвращает id и запись целиком. */
function entryOf(state: any) {
  const id = 'wg-' + Math.random().toString(36).slice(2);
  const entry: any = { state, bus: new EventBus(), logs: [], pending: null };
  games.set(id, entry);
  return { id, entry };
}

afterEach(() => {
  // Чистим за собой записи этого файла, чтобы не копить их в общем сторе
  for (const key of Array.from(games.keys())) {
    if (String(key).startsWith('wg-')) games.delete(key as string);
  }
});

describe('Хвосты победы: уже объявленный победитель не перезаписывается (L432/L640/L671)', () => {
  it('L432 performPlayNow: p1 объявлен победителем, p2 догнал порог — winnerId остаётся p1', async () => {
    const state = mkState({ winnerId: 'p1' });
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');
    state.cards['c1'] = uni('c1');
    state.players[0].hand = ['c1'];

    // Контроль фикстуры: checkWin действительно хочет отдать победу p2
    expect(checkWin(state)).toBe('p2');

    const { id, entry } = entryOf(state);
    const res = await performPlayNow(entry, entry.state.players[0], id, 'c1');

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p1');
  });

  it('L432 позитив: winnerId пуст — победа записывается', async () => {
    const state = mkState();
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');
    state.cards['c1'] = uni('c1');
    state.players[0].hand = ['c1'];

    const { id, entry } = entryOf(state);
    const res = await performPlayNow(entry, entry.state.players[0], id, 'c1');

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p2');
  });

  it('L640 playCard: p1 объявлен победителем, p2 догнал порог — winnerId остаётся p1', async () => {
    const state = mkState({ winnerId: 'p1' });
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');
    state.cards['c1'] = uni('c1');
    state.players[0].hand = ['c1'];

    expect(checkWin(state)).toBe('p2');

    const { id, entry } = entryOf(state);
    const res = await playCard(id, 'p1', 'c1');

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p1');
  });

  it('L640 позитив: winnerId пуст — победа записывается', async () => {
    const state = mkState();
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');
    state.cards['c1'] = uni('c1');
    state.players[0].hand = ['c1'];

    const { id, entry } = entryOf(state);
    const res = await playCard(id, 'p1', 'c1');

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p2');
  });

  it('L671 endTurn: p1 объявлен победителем, p2 догнал порог — winnerId остаётся p1', async () => {
    const state = mkState({ winnerId: 'p1' });
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');

    expect(checkWin(state)).toBe('p2');

    const { id, entry } = entryOf(state);
    const res = await endTurn(id);

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p1');
  });

  it('L671 позитив: winnerId пуст — победа записывается', async () => {
    const state = mkState();
    giveUnicorns(state, 'p1', 5, 'a');
    giveUnicorns(state, 'p2', THRESHOLD, 'b');

    const { id, entry } = entryOf(state);
    const res = await endTurn(id);

    expect(res.ok).toBe(true);
    expect((entry.state as any).winnerId).toBe('p2');
  });
});
