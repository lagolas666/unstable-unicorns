{
  "name": "uu-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed:cards": "ts-node-dev --transpile-only src/scripts/seedCards.ts",
    "seed:horses": "ts-node-dev --transpile-only src/scripts/seedHorses.ts",
    "import:folder": "ts-node-dev --transpile-only src/scripts/importFromFolder.ts",
    "fill:unicorns": "ts-node-dev --transpile-only src/scripts/fillUnicornsFromWiki.ts",
    "analyze:unicorns": "ts-node-dev --transpile-only src/scripts/analyzeUnicornsRules.ts",
    "clear:cards": "ts-node-dev --transpile-only src/scripts/clearCards.ts --force",
    "import:xlsx": "ts-node-dev --transpile-only src/scripts/importFromXlsx.ts --file \"../Unicorns/Ссылки на единорогов.filled.xlsx\" --server http://localhost:3001",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "gen:unicorns": "ts-node-dev --transpile-only tools/generate-unicorns-json.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.3",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/supertest": "^2.0.16",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "optionalDependencies": {
    "xlsx": "^0.18.5"
  }
}
