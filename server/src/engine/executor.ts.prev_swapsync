// В6-2a/scope: запись о неразобранном селекторе. Форма согласована с Аналитиком:
// {cardId, mdNum, kind, rawScope, reason} — по ним видно, что именно не сыграло.
export interface ScopeUnresolved {
  cardId: string;
  mdNum?: number;
  kind: string;
  rawScope: string;
  reason: string;
}

export interface ResolveContext {
  state: GameState;
  bus: EventBus;
  /**
   * Optional: when resolving effects that require explicit targets (e.g., destroy),
   * routes may populate selectedTargets[sourceCardId] with card IDs chosen by the actor.
   */
  selectedTargets?: Record<string, string[]>;
  /**
   * Optional: when action requires selecting a player (e.g., destination stable for attach/move),
   * routes may populate selectedPlayers[sourceCardId] with playerId (or ids).
   */
  selectedPlayers?: Record<string, string | string[]>;
  /**
   * Internally set during resolveEffect to let action executors know which source card is active.
   */
  currentSourceId?: string;
  /**
   * Колбэк, предоставляемый роутером, чтобы инициировать окно реакций для триггерных эффектов.
   * Если задан, резолвер может не выполнять эффект немедленно, а создать pending-окно.
   */
  requestReactionWindow?: (params: {
    trigger: 'when_destroyed' | 'when_enters';
    actorId: string;
    sourceCardId: string;
    effectIdx: number;
    uncounterable?: boolean;
    allow_intercept?: boolean;
  }) => void;
  /**
   * Пометка для полного предотвращения выполнения эффекта по sourceCardId.
   */
  preventEffects?: Record<string, boolean>;
  /**
   * Пометка для игнорирования конкретных целей по sourceCardId.
   */
  ignoreTargets?: Record<string, string[]>;
  /**
   * Колбэк окна выбора защитника (await_choice) для force_discard.
   * true = окно открыто: движок обязан остановиться и не трогать руку защитника.
   */
  /**
   * В6-2a: действия, у которых selector.scope не разобран движком. Заполняется на входе
   * resolveEffect; маршруты забирают список и отдают его в ack.extra.
   * Молчаливого «стреляем в себя» больше нет — такие действия не исполняются.
   */
  scopeUnresolved?: ScopeUnresolved[];
  /**
   * В6-3a/3-A: след пропущенного optional-добора. Optional draw адресован не актору (others/all) —
   * без согласия получателя он не исполняется, но пропуск обязан быть виден:
   * {cardId, kind, targetPlayer, playerId, quantity}. Молчаливых пропусков нет.
   */
  optionalSkipped?: Array<{ cardId: string; kind: string; targetPlayer: string; playerId: string; quantity: number }>;
  /** В6-2a: kind текущего действия — нужен getScopePlayers, чтобы отличить баг scope от неисполнимого kind. */
  currentActionKind?: string;
  requestChoice?: (params: {
    actorId: string;
    chooserId: string;
    sourceCardId: string | null;
    options: string[];
    remaining: number;
    done: string[];
    purpose?: string;
    deferred?: any;
  }) => boolean;
}

// Helper: попытаться перехватить магию, попавшую в сброс — если у кого-то есть Mystic Rainbow Unicorn
export function maybeInterceptMagicToHand(ctx: ResolveContext, originOwner: PlayerState, cardId: string): void {
  const card = ctx.state.cards[cardId] as any;
  if (!card || String(card.type) !== 'magic') return;
  // Найти владельца Mystic Rainbow Unicorn
  let catcher: PlayerState | undefined;
  for (const p of ctx.state.players) {
    for (const cid of p.stable) {
      const c = ctx.state.cards[cid] as any;
      const nameLower = String((c?.name || c?.Название || '')).toLowerCase();
      if (nameLower.includes('mystic') && nameLower.includes('rainbow') && nameLower.includes('unicorn')) {
        catcher = p; break;
      }
    }
    if (catcher) break;
  }
  // Только если это другой игрок ("another player")
  if (!catcher || catcher.id === originOwner.id) return;
  // Найти реальный массив discard и изъять карту
  const discardArr = getZoneArrayWithShared(ctx, originOwner, 'discard');
  const idx = discardArr.indexOf(cardId);
  if (idx === -1) return;
  discardArr.splice(idx, 1);
  catcher.hand.push(cardId);
}

function hasDoubleDestroyBonus(ctx: ResolveContext, player: PlayerState): boolean {
  // If player controls a card with flag double_destroy=true or named 'Epic Level Unicorn'
  for (const cid of player.stable) {
    const c: any = (ctx.state.cards as any)[cid];
    if (!c) continue;
    if (c.double_destroy === true) return true;
    const name = String((c?.name || c?.Название || '')).toLowerCase();
    if (name.includes('epic level unicorn')) return true;
  }
  return false;
}

// Замена уничтожения/жертвы (Единорог-Архангел): решает ДАННЫЕ, а не имя карты.
// Карта в стойле владельца с опциональным триггером on_would_be_destroyed_or_sacrificed даёт замену.
// Малыш-Архангел (effects: []) замены не даёт, поэтому имя здесь не сравниваем.
function findDestroyReplacer(ctx: ResolveContext, owner: PlayerState): string | null {
  for (const cid of owner.stable) {
    const c: any = ctx.state.cards[cid];
    const effs: any[] = Array.isArray(c?.effects) ? c.effects : [];
    if (effs.some((e) => e?.trigger === 'on_would_be_destroyed_or_sacrificed' && e.optional === true)) return cid;
  }
  return null;
}

// Нужна ли замена выбором владельца. 'none' — замены нет, уничтожаем штатно.
// 'open' — открыто окно выбора владельца, карта НЕ мутирует до ответа.
// 'blocked' — спросить нельзя (другое окно открыто), карту не трогаем.
function resolveDestroyReplacement(ctx: ResolveContext, actor: PlayerState, owner: PlayerState, zone: any, cardId: string, kind: 'destroy' | 'sacrifice'): 'none' | 'open' | 'blocked' {
  if ((ctx as any).payingCosts) return 'none';
  if (zone !== 'stable' || owner.hand.length === 0) return 'none';
  const replacerId = findDestroyReplacer(ctx, owner);
  if (!replacerId) return 'none';
  if (!ctx.requestChoice) return 'blocked';
  const opened = ctx.requestChoice({
    actorId: actor.id,
    chooserId: owner.id,
    sourceCardId: replacerId,
    options: owner.hand.slice(),
    remaining: 1,
    done: [],
    purpose: 'archangel_prevent',
    deferred: { zone, cardId, kind },
  });
  return opened ? 'open' : 'blocked';
}

// Штатное уничтожение/жертва, отложенное окном замены: вызывается при отказе или таймауте владельца.
export async function completeDeferredDestroy(ctx: ResolveContext, owner: PlayerState, zone: any, cardId: string, kind: 'destroy' | 'sacrifice'): Promise<void> {
  const srcArr = getZoneArrayWithShared(ctx, owner, zone);
  const idx = srcArr.indexOf(cardId);
  if (idx === -1) return;
  srcArr.splice(idx, 1);
  sendCardTo(ctx, owner, cardId, owner.discard);
  zombieKnightReturn(ctx, owner, cardId);
  if (kind === 'destroy') {
    maybeInterceptMagicToHand(ctx, owner, cardId);
    await triggerDestroyedEffectsFor(ctx, owner, cardId);
  }
}

export type TurnStartPrompt = { sourceCardId: string; effectIdx: number; uncounterable?: boolean };

/**
 * Trigger all effects with trigger=on_turn_start for the given player (assumes phase begin_turn).
 * Returns a list of optional effects that require player's choice (prompts). Non-optional effects are resolved immediately.
 */
export async function triggerTurnStartEffects(ctx: ResolveContext, currentPlayerId: string): Promise<TurnStartPrompt[]> {
  const player = ctx.state.players.find(p => p.id === currentPlayerId);
  if (!player) return [];
  // Iterate over all cards the player controls (primarily stable) and trigger their on_turn_start effects
  const ownedZones: Array<{ zone: 'stable' | 'field' } & { ids: string[] }> = [
    { zone: 'stable', ids: player.stable },
    { zone: 'field', ids: player.field },
  ];
  // Compute phases the player will skip this turn from continuous effects in their stable
  const skipped = new Set<string>();
  for (const cid of player.stable) {
    const c = ctx.state.cards[cid] as any;
    const arr = (c?.skip_phases as string[]) || [];
    for (const ph of arr) skipped.add(String(ph));
  }
  const prompts: TurnStartPrompt[] = [];
  for (const { zone, ids } of ownedZones) {
    for (const cid of [...ids]) { // copy to avoid mutation issues
      const card = ctx.state.cards[cid];
      if (!card || !Array.isArray((card as any).effects)) continue;
      const effects = (card as any).effects as Effect[];
      for (let i = 0; i < effects.length; i++) {
        const eff = effects[i];
        if (eff.trigger !== 'on_turn_start') continue;
        // If effect is blocked by player's skipped phases, do not trigger it
        const blockedList = (eff as any).blocked_by_phase_skip as string[] | undefined;
        if (blockedList && blockedList.some(ph => skipped.has(String(ph)))) {
          continue;
        }
        // Respect while_source_in if provided
        const whileZone = (eff as any).while_source_in as any | undefined;
        if (whileZone) {
          // verify source still in the specified zone for some owner
          let found = false;
          for (const p of ctx.state.players) {
            const arr = getZoneArrayWithShared(ctx, p, whileZone);
            if (arr.includes(cid)) { found = true; break; }
          }
          if (!found) continue;
        }
        if (eff.optional) {
          prompts.push({ sourceCardId: cid, effectIdx: i, uncounterable: !!(eff as any).uncounterable });
        } else {
          await resolveEffect(ctx, player, cid, eff);
        }
      }
    }
  }
  return prompts;
}

// Helper: return zone array respecting shared piles if present
function getZoneArrayWithShared(ctx: ResolveContext, player: PlayerState, zone: any): string[] {
  if (zone === 'deck' && ctx.state.deck) return ctx.state.deck;
  if (zone === 'discard' && ctx.state.discard) return ctx.state.discard;
  return getZoneArray(player, zone as any);
}

// exclude_self: карта, породившая эффект, не может быть выбрана целью собственного действия.
// BUG-NM-EXSELF: флаг стоит у 13 карт каталога v2, но движок его не читал —
// nightmare_unicorn_ultimate (sacrifice 3 при входе в стойло) жертвовал сам себя.
function matchesFilter(card: Card | undefined, filter: any, sourceId?: string): boolean {
  if (!filter || !card) return true;
  if (filter.exclude_self === true && sourceId && card.id === sourceId) return false;
  if (filter.card_group && !matchesCardGroup(card, filter.card_group)) return false;
  if (filter.category && filter.category !== 'any' && card.type !== filter.category) return false;
  if (filter.subtype && !cardSubtypeTags(card).includes(String(filter.subtype))) return false;
  if (filter.name && card.name !== filter.name) return false;
  if (filter.tags && filter.tags.length) {
    const tags = card.tags || [];
    for (const t of filter.tags) if (!tags.includes(t)) return false;
  }
  return true;
}

// Basic immunity flags support
function hasTag(card: Card | undefined, tag: string): boolean {
  if (!card) return false;
  const tags = (card as any).tags as string[] | undefined;
  return !!(tags && tags.includes(tag));
}

function hasImmunity(card: Card | undefined, kind: string): boolean {
  if (!card) return false;
  const immuneList = ((card as any).immune as string[] | undefined) || [];
  if (immuneList.includes(kind)) return true;
  // also respect explicit boolean flags if present on card
  if (kind === 'destroy' && ((card as any).cannot_be_destroyed === true || hasTag(card, 'cannotBeDestroyed'))) return true;
  // cannot be targeted blocks any hostile targeting
  if ((card as any).cannot_be_targeted === true || hasTag(card, 'cannotBeTargeted')) return true;
  return false;
}

function isTargetableFor(actionKind: string, card: Card | undefined, actorId: string, ownerId: string, state?: GameState): boolean {
  if (!card) return false;
  // Аура маски: пока штраф-маска лежит в конюшне владельца, его единорога нельзя выбрать целью
  // для sacrifice/steal/destroy/move/swap. Собственные эффекты самой карты при этом не отключаются.
  if (state && isActionBlockedByMask(actionKind) && isMaskedUnicorn(state, card, ownerId)) return false;
  // self-targeting is always allowed unless explicit immunity to that action exists
  const hostile = actorId !== ownerId;
  if (!hostile) {
    if (actionKind === 'destroy') return !hasImmunity(card, 'destroy');
    return true;
  }
  // hostile actions respect cannot_be_targeted and specific immunities
  if ((card as any).cannot_be_targeted === true || hasTag(card, 'cannotBeTargeted')) return false;
  if (actionKind === 'destroy' && hasImmunity(card, 'destroy')) return false;
  if (actionKind === 'steal' && (hasTag(card, 'neighproof') || ((card as any).immune && (card as any).immune.includes('steal')))) return false;
  return true;
}

// Единый классификатор из engine/unicornTypes.ts (4 типа каталога, без generic 'unicorn').
function isUnicornCategory(t: Card['type']): boolean {
  return isUnicornCard(t);
}

// Делегирует канонический классификатор (учитывает массивы групп из каталога v2).
function matchesCardGroup(card: Card | undefined, group: any): boolean {
  return cardMatchesGroup(card, group);
}

// Helper: place a found card according to place mode
async function placeFoundCard(
  ctx: ResolveContext,
  actor: PlayerState,
  cardId: string,
  place: 'hand' | 'stable' | 'top_deck' | 'play_now' | undefined
): Promise<void> {
  const card = ctx.state.cards[cardId] as any;
  const mode = place || 'hand';
  if (mode === 'hand') {
    actor.hand.push(cardId);
    return;
  }
  if (mode === 'top_deck') {
    const deck = (ctx.state.deck ?? actor.deck);
    deck.push(cardId);
    return;
  }
  if (mode === 'stable') {
    actor.stable.push(cardId);
    await triggerEnterEffectsFor(ctx, actor, cardId);
    return;
  }
  if (mode === 'play_now') {
    // Minimal semantics:
    // - Unicorns: enter stable and trigger enter effects
    // - Magic/Instant: resolve first immediate/on_play effect, then send to discard
    const t = String(card?.type || '');
    if (isUnicornCategory(t as any)) {
      actor.stable.push(cardId);
      await triggerEnterEffectsFor(ctx, actor, cardId);
      return;
    }
    // Magic/Instant
    const effects = (card?.effects as any[]) || [];
    const eff = effects.find((e) => e && (e.trigger === 'immediate' || e.trigger === 'on_play'));
    if (eff) {
      await resolveEffect(ctx, actor, cardId, eff as any);
    }
    // Place into discard by default after play_now for non-unicorns
    actor.discard.push(cardId);
    return;
  }
}

// Helper: when a card is moved into a stable with on_enter_mode, execute its on_play/on_enter_stable effects
export async function triggerEnterEffectsFor(ctx: ResolveContext, owner: PlayerState, cardId: string, opts?: { skipGenericLoop?: boolean }): Promise<void> {
  const card = ctx.state.cards[cardId];
  if (!card) return;
  const effects = (Array.isArray((card as any).effects) ? (card as any).effects : []) as Effect[];
  // Вход в стойло: единственный источник истины — данные карты (effects.on_enter_stable), драйвер ниже.
  // Фолбэк-блоки по имени (Nightmare / Archangel) снесены 05.11.2026: у Малышей (baby_nightmare_unicorn,
  // baby_archangel_unicorn) effects: [] и пустой текст карты, а подстрока "nightmare"/"archangel" ложно
  // запускала жертву 3 карт, включая саму карту-источник (BUG-NM-EXSELF на Малыше: вход в стойло → сброс).
  // У ultimate-версий эффект входа уже в данных, поэтому фолбэк им был не нужен и не исполнялся.
  // Generic-цикл: вызов из playCard пропускает его целиком — on_play уже исполнен там (gameService L624–629).
  // on_enter_stable в generic-цикле больше не слушаем: вход в стойло идёт из данных (effects.on_enter_stable).
  // Драйвер входа в стойло из данных (вариант 1, решение Аналитика 03.11.2026):
  // on_enter_stable из каталога исполняется ДО проверки skipGenericLoop, потому что playCard
  // глушит только generic-цикл on_play, а вход в стойло обязан работать и при skipGenericLoop: true.
  // optional: true автоматически не исполняем — это выбор игрока, окна выбора на входе пока нет.
  for (let i = 0; i < effects.length; i++) {
    const effEnter = effects[i] as any;
    if (effEnter && effEnter.trigger === 'on_enter_stable' && effEnter.optional !== true) {
      await resolveEffect(ctx, owner, cardId, effEnter);
    }
  }
  if (opts?.skipGenericLoop) return;
  for (let i = 0; i < effects.length; i++) {
    const eff = effects[i] as any;
    if (eff.trigger === 'on_play') {
      // Если доступен колбэк открытия окна и эффект потенциально конфликтный — инициируем окно
      const actions = Array.isArray(eff.actions) ? eff.actions : [];
      const hasDanger = actions.some((a: any) => ['destroy', 'steal', 'sacrifice'].includes(String(a?.kind)));
      const uncounterable = !!eff.uncounterable;
      const allowIntercept = actions.some((a: any) => a && a.kind === 'steal');
      if (ctx.requestReactionWindow && (hasDanger || uncounterable || allowIntercept)) {
        ctx.requestReactionWindow({
          trigger: 'when_enters',
          actorId: owner.id,
          sourceCardId: cardId,
          effectIdx: i,
          uncounterable,
          allow_intercept: allowIntercept,
        });
      } else {
        await resolveEffect(ctx, owner, cardId, eff);
      }
    }
  }
}

// Helper: when a card is destroyed (moved from stable to discard), execute its when_destroyed effects for the previous owner
async function triggerDestroyedEffectsFor(ctx: ResolveContext, owner: PlayerState, cardId: string): Promise<void> {
  const card = ctx.state.cards[cardId];
  if (!card || !Array.isArray((card as any).effects)) return;
  const effects = (card as any).effects as Effect[];
  for (let i = 0; i < effects.length; i++) {
    const eff = effects[i] as any;
    if (eff.trigger === 'when_destroyed') {
      const actions = Array.isArray(eff.actions) ? eff.actions : [];
      const hasDanger = actions.some((a: any) => ['destroy', 'steal', 'sacrifice'].includes(String(a?.kind)));
      const uncounterable = !!eff.uncounterable;
      const allowIntercept = actions.some((a: any) => a && a.kind === 'steal');
      if (ctx.requestReactionWindow && (hasDanger || uncounterable || allowIntercept)) {
        ctx.requestReactionWindow({
          trigger: 'when_destroyed',
          actorId: owner.id,
          sourceCardId: cardId,
          effectIdx: i,
          uncounterable,
          allow_intercept: allowIntercept,
        });
      } else {
        await resolveEffect(ctx, owner, cardId, eff);
      }
    }
  }
}

