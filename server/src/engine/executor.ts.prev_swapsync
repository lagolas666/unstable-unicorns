        outer2: for (const owner of owners) {
          const srcArr = getZoneArrayWithShared(ctx, owner, zone);
          for (let i = srcArr.length - 1; i >= 0 && moved < qty; i--) {
            const cand = srcArr[i];
            const card = ctx.state.cards[cand];
            const sourceId2 = (ctx as any).currentSourceId as string | undefined;
            const ignored = sourceId2 && (ctx as any).ignoreTargets && (ctx as any).ignoreTargets[sourceId2] && (ctx as any).ignoreTargets[sourceId2].includes(cand);
            if (!matchesCardGroup(card as any, group) || ignored) continue;
            if (!isTargetableFor(String(action.kind), card, player.id, owner.id, ctx.state)) continue;
            if (!isCardAvailableFromZone(card as any, zone)) continue;
            srcArr.splice(i, 1);
            dstArr.push(cand);
            const enterMode = (action as any).on_enter_mode as ('as_on_play' | 'none' | undefined);
            if (enterMode === 'as_on_play' && destZone === 'stable') {
              await triggerEnterEffectsFor(ctx, destOwner, cand);
            }
            moved++;
            if (moved >= qty) break outer2;
          }
