        const srcArr = getZoneArrayWithShared(ctx, owner, zone);
        const idx = srcArr.indexOf(id);
        if (idx === -1) continue;
        srcArr.splice(idx, 1);
        dstArr.push(id);
        const enterMode = (action as any).on_enter_mode as ('as_on_play' | 'none' | undefined);
