const router = Router();

// D1b: после победы партия окончена — мутирующие входы отдают 409 без единой мутации.
// Проверка одна на весь роутер: иначе каждый новый маршрут снова открывал бы мёртвую партию.
// Пропускаем: чтение (GET/HEAD), создание партии (POST /) и служебные /test/* —
// они готовят фикстуру, в том числе выставляют winnerId.
function gameOverGate(req: Request, res: Response, next: any) {
  const method = String(req.method || 'GET').toUpperCase();
  if (method === 'GET' || method === 'HEAD' || method === 'OPTIONS') return next();
  // req.path в router.use относительный: '/<id>/play' -> id = 'gameid'
  const rel = String(req.path || '/' );
  if (rel === '/' || rel === '' || rel.startsWith('/test')) return next();
  const gameId = rel.split('/').filter(Boolean)[0] || '';
  const entry = gameId ? games.get(gameId) : undefined;
  const winnerId = entry && (entry.state as any).winnerId;
  if (winnerId) return res.status(409).json({ message: 'Game is over', gameOver: true, winnerId });
  return next();
}
router.use(gameOverGate);

