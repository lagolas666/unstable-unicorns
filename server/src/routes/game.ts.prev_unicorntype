// POST /api/game/:id/playWithTargets { cardId: string, targets: string[] }
// Same as /play, but accepts explicit target IDs for effects that require selection (e.g., destroy)
router.post('/:id/playWithTargets', async (req: Request, res: Response) => {
  const entry = games.get(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Game not found' });
  const { state } = entry;
  const player = state.players.find((p) => p.id === state.turn.currentPlayerId)!;
  const cardId = String(req.body?.cardId || '');
  const targets = Array.isArray(req.body?.targets) ? (req.body.targets as string[]) : [];
  const targetPlayerId = req.body?.targetPlayerId ? String(req.body.targetPlayerId) : '';
  if (state.turn.phase !== 'action') return res.status(400).json({ message: 'Not in action phase' });
  if (player.action_points <= 0) return res.status(400).json({ message: 'No action points' });
  {
    const skipped = Array.isArray((state.turn as any).skippedPhases) ? ((state.turn as any).skippedPhases as string[]) : [];
    if (skipped.includes('play')) return res.status(400).json({ message: 'Вы не можете разыгрывать карты в этом ходу' });
  }
  const idx = player.hand.indexOf(cardId);
  if (idx === -1) return res.status(400).json({ message: 'Card not in hand' });
  // Do not remove from hand until all validations/costs pass
  const card = state.cards[cardId];
  const base = ctxFor(req.params.id)!;
  // Basic validation for targets against the first destroy action (if any)
  const effects = ((card as any)?.effects as any[]) || [];
  const eff = effects.find((ef) => (ef.trigger === 'on_play' || ef.trigger === 'immediate') && Array.isArray(ef.actions) && ef.actions.some((a: any) => a.kind === 'destroy'));
  if (eff) {
    const action = eff.actions.find((a: any) => a.kind === 'destroy') as any;
    const sel = action?.targets || {};
    const qty = Number(sel?.quantity?.value ?? 1);
    const scope = String(sel?.scope || 'opponent');
    const zone = String(sel?.zone || 'stable');
    const group = sel?.filters?.card_group as string | undefined;
    // Too many targets provided
    if (Array.isArray(targets) && targets.length > qty) {
      return res.status(400).json({ message: `Too many targets provided (${targets.length}/${qty})` });
    }
    // Duplicate targets provided
    if (Array.isArray(targets) && new Set(targets).size !== targets.length) {
      return res.status(400).json({ message: 'Duplicate targets provided' });
    }
    if (!Array.isArray(targets) || targets.length < qty) {
      const willOpenPending = hasDangerousEffect(card) || hasUnicornOnPlayEffect(card);
      // Build owners list per scope to compute available target options
      let ownersOpt = [] as typeof state.players;
      switch (scope) {
        case 'self': ownersOpt = [player]; break;
        case 'opponent': ownersOpt = state.players.filter(p => p.id !== player.id); break;
        case 'any_player':
        case 'all_players': ownersOpt = state.players.slice(); break;
        default: ownersOpt = [player]; break;
      }
      const zoneGetterOpt = (p: any): string[] => zone === 'stable' ? p.stable : zone === 'hand' ? p.hand : zone === 'discard' ? p.discard : zone === 'nursery' ? p.nursery : zone === 'field' ? p.field : zone === 'deck' ? (state.deck || []) : [];
      const validTargets: string[] = [];
      for (const own of ownersOpt) {
        const arr = zoneGetterOpt(own);
        for (const tid of arr) {
          const c = state.cards[tid] as any;
          if (matchesCardGroup(c, group)) validTargets.push(tid);
        }
      }
      if (!willOpenPending || qty > 1) {
        return res.status(409).json({
          message: `Not enough targets provided (${targets?.length ?? 0}/${qty})`,
          needTargets: true,
          kind: 'targets',
          options: { targets: validTargets },
        });
      }
    }
    // Build owners list per scope
    let owners = [] as typeof state.players;
    switch (scope) {
      case 'self': owners = [player]; break;
      case 'opponent': owners = state.players.filter(p => p.id !== player.id); break;
      case 'any_player':
      case 'all_players': owners = state.players.slice(); break;
      default: owners = [player]; break;
    }
    const zoneGetter = (p: any): string[] => zone === 'stable' ? p.stable : zone === 'hand' ? p.hand : zone === 'discard' ? p.discard : zone === 'nursery' ? p.nursery : zone === 'field' ? p.field : zone === 'deck' ? (state.deck || []) : [];
    // Validate each target
    for (const tid of targets.slice(0, qty)) {
      let ok = false;
      for (const own of owners) {
        const arr = zoneGetter(own);
        if (arr.includes(tid)) {
          const c = state.cards[tid] as any;
          if (matchesCardGroup(c, group)) { ok = true; break; }
        }
      }
      if (!ok) return res.status(400).json({ message: `Invalid target: ${tid}` });
    }
  }
  // If dangerous effect OR unicorn with on_play/immediate effects, open reaction window and store preselected choices
  if (hasDangerousEffect(card) || hasUnicornOnPlayEffect(card)) {
    if (entry.pending) return res.status(400).json({ message: 'Another action pending' });
    // Determine uncounterable based on the dangerous effect metadata
    const effectsAll = ((card as any)?.effects as any[]) || [];
    const firstOnPlay = effectsAll.find((ef: any) => (ef.trigger === 'on_play' || ef.trigger === 'immediate') && Array.isArray(ef.actions));
    const uncounterable = !!(firstOnPlay && (firstOnPlay as any).uncounterable);
    entry.pending = { kind: 'play', actorId: player.id, cardId, prefill: { targets, playerId: targetPlayerId || undefined }, cancelLevel: 0, expiresAt: Date.now() + 5000, uncounterable } as any;
    // Stash preselected choices for later execution
    (entry.pending as any).preTargets = targets;
    if (targetPlayerId) (entry.pending as any).preTargetPlayerId = targetPlayerId;
    schedulePendingResolution(req.params.id, 5000);
    entry.logs.push({ t: Date.now(), type: 'play', playerId: player.id, details: { pending: 'play', cardId, via: 'playWithTargets:autoWindow', targets, targetPlayerId } });
    try {
      const io: any = (req.app as any).get('io');
      io?.to?.(`game:${req.params.id}`)?.emit?.('pending_update', entry.pending);
      io?.to?.(`game:${req.params.id}`)?.emit?.('logs_update', entry.logs.slice(-100));
    } catch {}
    return res.json({ pending: entry.pending, state });
  }

  const ctx = { ...base.ctx, selectedTargets: { [cardId]: targets }, selectedPlayers: targetPlayerId ? { [cardId]: targetPlayerId } : undefined } as ResolveContext;

  // If the card is an upgrade/downgrade: for downgrade require choosing opponent; for upgrade default to self if not provided
  const ctypePre = (card as any)?.type as string;
  if (ctypePre === 'downgrade') {
    const owners = state.players.filter(p => p.id !== player.id);
    if (!targetPlayerId) {
      return res.status(409).json({ message: 'Player target required', needTargets: true, kind: 'players', options: { players: owners.map(p => p.id) } });
    }
  }

  // Before resolving costs, check if costs require explicit targets selection (discard/sacrifice)
  const costs = (card as any)?.play_requirements?.costs as any[] | undefined;
  if (costs && costs.length) {
    // gather candidates
    const need = costs.find((a: any) => ['discard','sacrifice'].includes(String(a.kind)));
    if (need) {
      const sel: any = need.targets || {};
      const qty = Number(sel?.quantity?.value ?? 1);
      const zone = String(sel?.zone || (need.kind === 'discard' ? 'hand' : 'stable'));
      const group = sel?.filters?.card_group as string | undefined;
      const srcArr = zone === 'hand' ? player.hand : zone === 'stable' ? player.stable : [];
      const candidates: string[] = [];
      for (const id of srcArr) {
        const c = state.cards[id] as any;
        if (matchesCardGroup(c, group)) candidates.push(id);
      }
      // DEF-04: нехватка кандидатов для оплаты cost — отказываем ДО resolveActions,
      // иначе executor опустошает руку, и карта сгорает при провале оплаты
      if (candidates.length < qty) {
        return res.status(400).json({ message: 'Cannot pay costs' });
      }
      // if client hasn't preselected, ask to pick
      const chosen = (ctx as any).selectedTargets?.[cardId] || [];
      if (!Array.isArray(chosen) || chosen.length < qty) {
        return res.status(409).json({ message: 'Targets required', needTargets: true, kind: String(need.kind), options: { targets: candidates } });
      }
    }
  }
  // Resolve costs (ensure currentSourceId is set so executors can read selectedTargets for costs)
  if (costs && costs.length) {
    (ctx as any).currentSourceId = cardId;
    const ok = await resolveActions(ctx, player, costs as any);
    (ctx as any).currentSourceId = undefined;
    if (!ok) {
      return res.status(400).json({ message: 'Cannot pay costs' });
    }
  }

  // Only now remove from hand
  player.hand.splice(idx, 1);
  // Place depending on card type
  const ctype = (card as any)?.type as string;
  if (ctype === 'magic' || ctype === 'instant') {
    // Temporarily place nowhere; resolve effects then send to discard
  } else if (ctype === 'upgrade' || ctype === 'downgrade') {
    // Allow attaching to selected player's stable if provided
    let owner: PlayerState = player;
    const pid = targetPlayerId || ((ctx as any).selectedPlayers?.[cardId] as string | undefined);
    if (pid) {
      const o = state.players.find(p => p.id === pid);
      if (o) owner = o;
    }
    owner.stable.push(cardId);
  } else {
    player.stable.push(cardId);
  }

  // Resolve on_play/immediate with provided targets
  // Respect Hypnorog cancel if it was used in the reaction window for this pending play
  const pLocalPwT = entry.pending as any;
  const hypnoCanceledPwT = !!(pLocalPwT && pLocalPwT.kind === 'play' && pLocalPwT.cardId === cardId && pLocalPwT.hypnorog && pLocalPwT.hypnorog.cancel);
  if (!hypnoCanceledPwT) {
    const effects2 = (card?.effects as any as Effect[]) || [];
    for (const ef of effects2) {
      if ((ef as any).trigger === 'on_play' || (ef as any).trigger === 'immediate') {
        await resolveEffect(ctx, player, cardId, ef);
      }
    }
  }

  // After resolving, handle magic/instant placement to discard
  if (ctype === 'magic' || ctype === 'instant') {
    if (!state.discard) (state as any).discard = [];
    state.discard!.push(cardId);
  }

  // Spend AP and log
  player.action_points = Math.max(0, (player.action_points || 0) - 1);
  entry.logs.push({ t: Date.now(), type: 'play', playerId: player.id, details: { cardId, name: (state.cards as any)[cardId]?.name, via: 'playWithTargets', targets } });

  const winner = checkWin(state);
  // Победитель уже объявлен — не перезаписываем (winnerId = защёлка)
  if (winner && !(state as any).winnerId) (state as any).winnerId = winner;
  try {
    const io: any = (req.app as any).get('io');
    io?.to?.(`game:${req.params.id}`)?.emit?.('state_update', state);
    io?.to?.(`game:${req.params.id}`)?.emit?.('logs_update', entry.logs.slice(-100));
  } catch {}
  res.json(state);
});

// POST /api/game/:id/play { cardId: string }
router.post('/:id/play', async (req, res) => {
  const cardId = String(req.body?.cardId || '');
  // REST передаёт текущего игрока: проверка чужих ходов остаётся за сервисом
  const entry0 = games.get(String(req.params.id));
  if (!entry0) return res.status(404).json({ message: 'Game not found' });
  const playerId = entry0.state.turn.currentPlayerId;
  // Цели оплаты стоимости из тела запроса: без них ctx пересоздаётся и 409 не закрыть
  const chosenCostTargets = req.body?.chosenCostTargets;
  // Цель розыгрыша (upgrade/downgrade) и цели эффектов тоже приходят телом:
  // без них /play всегда отвечал 409 на downgrade и клал карту в стойло актора.
  const targetPlayerId = req.body?.targetPlayerId ? String(req.body.targetPlayerId) : undefined;
  const targets = Array.isArray(req.body?.targets) ? (req.body.targets as unknown[]).map((t) => String(t)) : undefined;
  const result = await playCard(String(req.params.id), playerId, cardId, { chosenCostTargets, targetPlayerId, targets });
  if (!result.ok) {
    const payload: any = { message: result.message };
    if (result.extra) Object.assign(payload, result.extra);
    return res.status(result.http).json(payload);
  }
  const state = result.state;
  try {
    const io: any = (req.app as any).get('io');
    if (result.pending) {
      io?.to?.(`game:${req.params.id}`)?.emit?.('pending_update', result.pending);
      io?.to?.(`game:${req.params.id}`)?.emit?.('logs_update', result.logs.slice(-100));
    } else {
      io?.to?.(`game:${req.params.id}`)?.emit?.('state_update', state);
      io?.to?.(`game:${req.params.id}`)?.emit?.('logs_update', result.logs.slice(-100));
    }
  } catch {}
  if (result.pending) return res.json({ pending: result.pending, state });
  res.json(state);
});

