// POST /api/game
// body: { players: [{ id: string, deckCardIds?: string[] }]} -> initialize game with shuffled decks
router.post('/', async (req, res) => {
  try {
    const { players } = req.body as { players: { id: string; deckCardIds?: string[]; seedTop?: string[] }[] };
    if (!players || players.length < 2) return res.status(400).json({ message: 'Need at least 2 players' });

    // Load all cards dictionary (optional DB)
    let cards: Card[] = [] as any;
    try {
      // DEF-06: без активного соединения mongoose буферизует запрос и висит bufferTimeoutMS (10 с).
      // Если соединения нет — сразу используем встроенный seed ниже, ответ остаётся прежним.
      if (mongoose.connection.readyState === 1) {
        cards = await CardModel.find().lean<Card[]>();
      }
    } catch (_) {
      // no DB available; continue with seed
      cards = [] as any;
    }

    const dict: Record<string, Card> = {} as any;
    for (const c of cards) dict[(c as any)._id || (c as any).id || (c as any).id] = c as any;

    // Without Mongo: real card catalog from server/data/catalog.fixture.json (565 cards, 95 baby_unicorn).
    // Needed so Nursery distribution and reaction windows can be checked on real data (TC-026).
    // Test seed below stays as the last fallback: if the fixture is missing, behaviour is unchanged.
    if (Object.keys(dict).length === 0) {
      const fixture = loadCatalogFixture();
      for (const c of fixture) {
        const key = (c as any).id || (c as any)._id;
        if (key) dict[key] = c as any;
      }
    }

    // Last-resort test seed: no baby_unicorn and no Neigh cards in it.
    if (Object.keys(dict).length === 0) {
      const seed: Array<Partial<Card> & { id: string }> = [
        { id: 'c_basic_1', name: 'Базовый Единорог', type: 'basic_unicorn' as any, effects: [] as any },
        { id: 'c_magic_draw', name: 'Магия: Возьми 1', type: 'magic' as any, effects: [ { trigger: 'immediate', actions: [ { kind: 'add', source: 'deck', destination: 'hand', quantity: { value: 1 } } ] } ] as any },
        { id: 'c_magic_search', name: 'Магия: Поиск 1', type: 'magic' as any, effects: [ { trigger: 'immediate', actions: [ { kind: 'search', targets: { scope: 'self', zone: 'deck', quantity: { value: 1 } } } ] } ] as any },
        // Тестовая карта: Уничтожь 1 единорога у оппонента
        { id: 'c_magic_destroy1', name: 'Магия: Уничтожь 1', type: 'magic' as any, effects: [ { trigger: 'immediate', actions: [ { kind: 'destroy', targets: { scope: 'opponent', zone: 'stable', quantity: { value: 1 }, filters: { card_group: 'unicorn' } } } ] } ] as any },
        // Тестовая карта: Укради 1 единорога у оппонента
        { id: 'c_magic_steal1', name: 'Магия: Укради 1', type: 'magic' as any, effects: [ { trigger: 'immediate', actions: [ { kind: 'steal', from: { scope: 'opponent', zone: 'stable', quantity: { value: 1 }, filters: { card_group: 'unicorn' } }, to: { scope: 'self', zone: 'stable' } } ] } ] as any },
      ];
      for (const s of seed) (dict as any)[s.id] = s as Card;
    }
    // Флаги реакций по имени карты (таблица data/canReactFlags.ts) — единая точка наложения
    applyCanReactFlagsToDict(dict);

    const allIds = Object.keys(dict);
    const playerStates: PlayerState[] = players.map((p) => ({
      id: p.id,
      deck: [], // per-player decks not used with shared deck
      hand: [],
      discard: [],
      stable: [],
      nursery: [],
      field: [],
      action_points: 1,
    }));

    // Build a single shared deck for the whole table.
    // Число копий каждой карты берётся из настройки админки: card.deck_count (по умолчанию 1).
    // Карты с active === false и с deck_count <= 0 в колоду не попадают.
    // Baby-единороги в основную колоду не идут — они живут в отдельной колоде Nursery (см. ниже).
    let shared: string[] = [];
    for (const cid of allIds) {
      const card: any = (dict as any)[cid];
      if (card?.active === false) continue;
      if (isNurseryOnly(card)) continue;
      const rawCount: any = card?.deck_count;
      const n = Number(rawCount);
      const count = Number.isFinite(n) ? Math.max(0, Math.floor(n)) : 1;
      for (let i = 0; i < count; i++) shared.push(cid);
    }
    // Shuffle shared deck
    for (let i = shared.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shared[i], shared[j]] = [shared[j], shared[i]];
    }

    // Отдельная колода Nursery: baby-единороги по копиям из той же настройки админки.
    const nurseryIds: string[] = [];
    for (const cid of allIds) {
      const card: any = (dict as any)[cid];
      if (!isNurseryOnly(card)) continue;
      if (card?.active === false) continue;
      const rawCount: any = card?.deck_count;
      const n = Number(rawCount);
      const count = Number.isFinite(n) ? Math.max(0, Math.floor(n)) : 1;
      for (let i = 0; i < count; i++) nurseryIds.push(cid);
    }

    const state: GameState = {
      players: playerStates,
      turn: { currentPlayerId: playerStates[0].id, phase: 'begin_turn', has_drawn: false },
      cards: dict,
      deck: shared,
      discard: [],
      nursery: nurseryIds,
    };
    const bus = new EventBus();

    const id = makeId();
    games.set(id, { state, bus, logs: [], pending: null });

    // After shuffle, optionally place seedTop cards on top of the SHARED deck (top is end of array)
    // For now, only the first provided non-empty seedTop is respected (prototype helper)
    const firstSeed = players.find(p => (p as any).seedTop && (p as any).seedTop.length) as any;
    if (firstSeed?.seedTop?.length) {
      for (const cid of firstSeed.seedTop as string[]) {
        const pos = state.deck!.indexOf(cid);
        if (pos !== -1) {
          state.deck!.splice(pos, 1);
          state.deck!.push(cid);
        }
      }
    }

    // Каждый игрок начинает с Baby Unicorn в стойле. Baby берётся из колоды Nursery,
    // основная колода baby не содержит (см. сборку shared выше).
    // Если в каталоге нет baby-карты — заводим служебную, чтобы старт игры не падал.
    // Каждый игрок получает СВОЮ копию из Nursery: брать один и тот же babyId на всех нельзя,
    // иначе один экземпляр оказывается в стойлах всех игроков, а Nursery теряет 1 карту вместо N.
    if (!state.nursery) state.nursery = [];
    const nursery = state.nursery;
    state.players.forEach((ps, i) => {
      let idx = nursery.findIndex((cid: string) => isNurseryOnly((dict as any)[cid]));
      let babyId: string;
      if (idx !== -1) {
        babyId = nursery[idx];
        nursery.splice(idx, 1);
      } else {
        // Nursery исчерпан — заводим служебную копию, чтобы игрок не остался без стойла
        babyId = 'c_baby_unicorn_' + (i + 1);
        (dict as any)[babyId] = { id: babyId, name: 'Малыш Единорог', type: 'baby_unicorn', source_zone: 'nursery_only', effects: [] } as any;
      }
      ps.stable.push(babyId);
    });

    // Draw 5 each as a starting hand
    for (const ps of state.players) {
      for (let i = 0; i < 5; i++) {
        const top = state.deck!.pop();
        if (top) ps.hand.push(top);
      }
    }

    // Emit create event (optional initial broadcast)
    try { const io: any = (req.app as any).get('io'); io?.to?.(`game:${id}`)?.emit?.('state_update', { id, state }); } catch {}
    res.status(201).json({ id, state });
  } catch (e) {
    res.status(500).json({ message: 'Failed to create game' });
  }
});

