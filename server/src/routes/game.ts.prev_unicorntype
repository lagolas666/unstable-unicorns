// GET /api/game/:id/effectTargetOptions?sourceCardId=...&effectIdx=...&actionPart=from|targets
// Возвращает варианты целей для конкретного эффекта карты (например, выбор карты из сброса на on_turn_start)
router.get('/:id/effectTargetOptions', (req, res) => {
  const entry = games.get(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Game not found' });
  const { state } = entry;
  const current = state.players.find(p => p.id === state.turn.currentPlayerId)!;
  const sourceCardId = String(req.query.sourceCardId || '');
  const effectIdx = Number(req.query.effectIdx ?? -1);
  const actionPart = String(req.query.actionPart || 'from'); // селектор берём из from или targets
  if (!sourceCardId) return res.status(400).json({ message: 'sourceCardId required' });
  const card = state.cards[sourceCardId] as any;
  if (!card) return res.status(404).json({ message: 'Card not found' });
  const effects = (card.effects as any[]) || [];
  if (effectIdx < 0 || effectIdx >= effects.length) return res.status(400).json({ message: 'Invalid effectIdx' });
  const eff = effects[effectIdx] as any;
  if (!eff || !Array.isArray(eff.actions)) return res.json({ targets: [] });
  // Берём первую action, содержащую указанный селектор
  const action = eff.actions.find((a: any) => a && (a[actionPart] || a.targets)) as any;
  const sel = (action?.[actionPart]) || action?.targets || {};
  const scope = String(sel?.scope || 'self');
  const zone = String(sel?.zone || 'stable');
  const group = sel?.filters?.card_group as string | undefined;
  let owners = [] as typeof state.players;
  switch (scope) {
    case 'self': owners = [current]; break;
    case 'opponent': owners = state.players.filter(p => p.id !== current.id); break;
    case 'any_player':
    case 'all_players': owners = state.players.slice(); break;
    default: owners = [current]; break;
  }
  const zoneGetter = (p: any): string[] => zone === 'stable' ? p.stable
    : zone === 'hand' ? p.hand
    : zone === 'discard' ? p.discard
    : zone === 'nursery' ? p.nursery
    : zone === 'field' ? p.field
    : zone === 'deck' ? (state.deck || [])
    : [];
  const result: string[] = [];
  for (const own of owners) {
    const arr = zoneGetter(own);
    for (const id of arr) {
      const c = state.cards[id] as any;
      if (matchesCardGroup(c, group)) result.push(id);
    }
  }
  return res.json({ targets: result, selector: { scope, zone, filters: sel?.filters || null } });
});

// GET /api/game/:id/targetOptions?cardId=...&kind=destroy
// Returns a list of valid target cardIds for the specified card's first matching action (defaults to destroy)
router.get('/:id/targetOptions', (req, res) => {
  const entry = games.get(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Game not found' });
  const { state } = entry;
  const current = state.players.find(p => p.id === state.turn.currentPlayerId)!;
  const cardId = String(req.query.cardId || '');
  const kind = String(req.query.kind || 'destroy');
  const mode = String(req.query.mode || 'cards'); // 'cards' | 'players'
  if (!cardId) return res.status(400).json({ message: 'cardId required' });
  const card = state.cards[cardId] as any;
  if (!card) return res.status(404).json({ message: 'Card not found' });
  const effects = (card.effects as any[]) || [];
  const eff = effects.find((ef) => (ef.trigger === 'on_play' || ef.trigger === 'immediate') && Array.isArray(ef.actions) && ef.actions.some((a: any) => a.kind === kind));
  if (!eff) return res.json({ targets: [] });
  const action = eff.actions.find((a: any) => a.kind === kind) as any;
  // Player-selection mode: return candidate playerIds for destination (to.scope) or selector scope
  if (mode === 'players') {
    const to = action?.to || {};
    const scope = String((to?.scope ?? (action?.targets?.scope)) || 'opponent');
    let owners = [] as typeof state.players;
    switch (scope) {
      case 'self': owners = [current]; break;
      case 'opponent': owners = state.players.filter(p => p.id !== current.id); break;
      case 'any_player':
      case 'all_players': owners = state.players.slice(); break;
      default: owners = [current]; break;
    }
    return res.json({ players: owners.map(p => p.id) });
  }
  const sel = action?.targets || action?.from || {};
  const scope = String(sel?.scope || 'opponent');
  const zone = String(sel?.zone || 'stable');
  const group = sel?.filters?.card_group as string | undefined;
  let owners = [] as typeof state.players;
  switch (scope) {
    case 'self': owners = [current]; break;
    case 'opponent': owners = state.players.filter(p => p.id !== current.id); break;
    case 'any_player':
    case 'all_players': owners = state.players.slice(); break;
    default: owners = [current]; break;
  }
  const result: string[] = [];
  for (const p of owners) {
    let arr: string[] = [];
    if (zone === 'stable') arr = p.stable;
    else if (zone === 'hand') arr = p.hand;
    else if (zone === 'discard') arr = p.discard;
    else if (zone === 'nursery') arr = p.nursery;
    else if (zone === 'field') arr = p.field;
    else if (zone === 'deck') arr = state.deck || [];
    else arr = [];
    for (const id of arr) {
      const c = state.cards[id] as any;
      if (matchesCardGroup(c, group)) result.push(id);
    }
  }
  res.json({ targets: result });
});


// POST /api/game/:id/turnStart
// resolve on_turn_start effects for current player; stays in begin_turn
router.post('/:id/turnStart', async (req, res) => {
  const entry = games.get(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Game not found' });
  const { state } = entry;
  if (state.turn.phase !== 'begin_turn') {
    return res.status(400).json({ message: 'Not in begin_turn' });
  }
  const { ctx, current } = ctxFor(req.params.id)!;
  const prompts = await triggerTurnStartEffects(ctx, current.id);
  if (prompts.length > 0) {
    entry.pending = { kind: 'prompt', actorId: current.id, prompts } as PendingPrompt;
    try {
      const io: any = (req.app as any).get('io');
      io?.to?.(`game:${req.params.id}`)?.emit?.('pending_update', entry.pending);
    } catch {}
  }
  entry.logs.push({ t: Date.now(), type: 'play', playerId: current.id, details: { turnStartResolved: prompts.length === 0 } });
  // Check win after start-of-turn effects
  const winnerStart = checkWin(state);
  // Победитель уже объявлен — не перезаписываем (winnerId = защёлка)
  if (winnerStart && !(state as any).winnerId) (state as any).winnerId = winnerStart;
  try {
    const io: any = (req.app as any).get('io');
    io?.to?.(`game:${req.params.id}`)?.emit?.('state_update', state);
    io?.to?.(`game:${req.params.id}`)?.emit?.('logs_update', entry.logs.slice(-100));
  } catch {}
  return res.json({ state, pending: entry.pending });
});

